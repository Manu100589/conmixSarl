# Clés API pour le Chatbot IA CONMIX SARL
# Renseignez l'une des clés suivantes (Gemini ou Groq).
# La route serveur /api/chat utilisera automatiquement celle qui est disponible en toute sécurité sans l'exposer au navigateur.

# Option 1 : Google Gemini API (Recommandé - Modèle gemini-1.5-flash / gemini-2.0-flash)
# Obtenez une clé gratuite sur https://aistudio.google.com/
GEMINI_API_KEY=

# Option 2 : Groq API (Ultra-rapide - Modèle llama-3.3-70b-versatile)
# Obtenez une clé gratuite sur https://console.groq.com/
GROQ_API_KEY=
